generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            String           @id
  nombre        String
  fechaRegistro DateTime         @default(now())
  activo        Boolean          @default(true)
  historial     HistorialDeUso[]
}

model HistorialDeUso {
  id            Int       @id @default(autoincrement())
  fechaUso      DateTime  @default(now())
  nombre        String
  promocion     Promocion @relation(fields: [promocionId], references: [id])
  promocionId   Int
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId     String
  trabajoId     Int
  valorPagado   Float
  valorOriginal Float
}

model Promocion {
  id             Int              @id @default(autoincrement())
  nombre         String
  codigo         String
  tipoDescuento  String
  valor          Float
  descripcion    String
  usoUnico       Boolean          @default(false)
  destacada      Boolean          @default(false)
  precioMinimo   Float?
  categorias   String[]
  eliminada      Boolean          @default(false)
  fechaInicio   DateTime          @default(now())
  fechaFin      DateTime?
  filtroUsuarios Json?
  historial      HistorialDeUso[]
}